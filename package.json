{
  "name": "hinks-garden-maintenance",
  "private": true,
  "description": "Static website. Node is only used at build time to generate pixel-art assets (scripts/generate-assets.js).",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/serve.js",
    "plan": "node scripts/plan.js",
    "assets": "node scripts/generate-assets.js",
    "assets:process": "node scripts/generate-assets.js --no-generate",
    "sprites": "node scripts/sprites.js",
    "frames": "node scripts/frames.js",
    "preview": "node scripts/preview.js"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.4"
  }
}
